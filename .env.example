# ==============================================================================
# CONFIGURACIÓN DE LA APLICACIÓN (App Config)
# ==============================================================================

# Entorno de ejecución de Spring Boot (dev, test, prod)
SPRING_PROFILES_ACTIVE=dev

# Puerto en el que se ejecutará la aplicación
SERVER_PORT=8080

# ==============================================================================
# BASE DE DATOS (Database)
# ==============================================================================

# URL de conexión JDBC para la base de datos PostgreSQL
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/proyecto_integrador_db?schema=public

# Nombre de usuario para la conexión a la base de datos
SPRING_DATASOURCE_USERNAME=postgres

# Contraseña para la conexión a la base de datos
SPRING_DATASOURCE_PASSWORD=tu_contraseña_segura_aqui

# Estrategia de inicialización y actualización del esquema de la base de datos (validate, update, create, create-drop)
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# Mostrar u ocultar las sentencias SQL en la consola (true/false)
SPRING_JPA_SHOW_SQL=true

# ==============================================================================
# AUTENTICACIÓN Y SEGURIDAD (Authentication)
# ==============================================================================

# Clave secreta utilizada para firmar y verificar los tokens JWT (debe ser una cadena larga y aleatoria)
JWT_SECRET=tu_clave_secreta_jwt_muy_larga_y_segura_para_firmar_tokens

# Tiempo de expiración del token JWT en milisegundos (ej: 86400000 = 24 horas)
JWT_EXPIRATION=86400000

# ==============================================================================
# CLAVES DE API Y SERVICIOS EXTERNOS (API Keys)
# ==============================================================================

# URL base o credenciales para servicios externos (si aplica)
EXTERNAL_API_BASE_URL=https://api.ejemplo.com/v1
EXTERNAL_API_KEY=tu_api_key_externa_aqui